---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Ellie Programing Language"
  description="Ellie is a scripting engine that runs on embedded and sandboxed environments."
  url="https://www.ellie-lang.org/releases"
>
  <main>
    <section class="theme-section section section-single-fullSize">
      <img
        class="display-center"
        alt="This page moved"
        src="https://media.giphy.com/media/oiy799TF4tLlCqZlJp/giphy-downsized.gif"
      />
      <br />
      <h2 class="text-center">This page moved</h2>
      <p class="text-center">
        Releases are now on <a href="https://lia.ellie-lang.org">Lia</a> with CLI
        updater
      </p>
      <br />
      <br />
    </section>
    <Footer />
  </main>
</Layout>
