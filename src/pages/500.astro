---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Ellie Programing Language - 500 Internal Server Error"
  description="500 Internal Server Error"
  url="https://www.ellie-lang.org"
  bodyClass="d-flex flex-column h-1001"
>
  <main>
    <section class="theme-section section section-single-fullSize">
      <img
        class="display-center"
        alt="500"
        src="https://media.giphy.com/media/NTur7XlVDUdqM/giphy.gif"
      />
      <br />
      <h2 class="text-center">500 - Internal Server Error</h2>
      <p class="text-center">
        Please try again later. If the problem persists, please contact us.
        <br />
        <a href="mailto:info@behemehal.org">info@behemehal.org</a>
      </p>
      <br />
      <br />
    </section>
    <Footer />
  </main>
</Layout>
